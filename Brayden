mission = telemetry("mission")

fig, axes = plt.subplots(
    3, 1,
    figsize=(10, 8),
    sharex=True,
    layout="constrained"
)

t = mission["t_s"]

# Plot motor shaft torques
for i in range(1, 5):
    axes[0].plot(
        t,
        mission[f"torque_{i}_Nm"],
        label=f"Motor {i}",
        linewidth=1.1
    )

# Plot individual rotor speeds
for i in range(1, 5):
    axes[1].plot(
        t,
        mission[f"omega_{i}_rad_s"],
        label=f"Rotor {i}",
        linewidth=1.1
    )

# Plot actual yaw angle
axes[2].plot(
    t,
    np.rad2deg(mission["yaw_rad"]),
    label="Actual yaw",
    linewidth=1.5
)

axes[0].set_ylabel("Applied shaft torque (N m)")
axes[1].set_ylabel("Rotor speed (rad/s)")
axes[2].set_ylabel("Yaw angle (degrees)")
axes[2].set_xlabel("Time (s)")

axes[0].legend(ncol=4, fontsize=8)

for ax in axes:
    ax.grid(alpha=0.25)

fig.suptitle(
    "ER2 | Motor torque drives rotor speed and attitude\n"
    "Complete flight sequence (simulated)"
)

plt.savefig(
    "AE352_ER2_Motor_Control_Verification.png",
    dpi=190,
    bbox_inches="tight"
)

plt.show()
