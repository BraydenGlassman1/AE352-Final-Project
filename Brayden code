fig, ax = plt.subplots(figsize=(10, 5.5))

ax.plot(
    mission["t_s"],
    mission["usable_soc"] * 100,
    color="green",
    linestyle="--",
    linewidth=1.4,
    alpha=0.45,
    label="Full mission",
    zorder=1
)

ax.plot(
    hover["t_s"],
    hover["usable_soc"] * 100,
    color="tab:blue",
    linestyle="-",
    linewidth=2.3,
    label="Hover (120 s)",
    zorder=3
)

ax.plot(
    circle["t_s"],
    circle["usable_soc"] * 100,
    color="tab:orange",
    linestyle=":",
    linewidth=2.6,
    label="Circular flight (65 s)",
    zorder=4
)

for data, color, marker in [
    (hover, "tab:blue", "o"),
    (circle, "tab:orange", "s"),
    (mission, "green", "^")
]:
    ax.scatter(
        data["t_s"].iloc[-1],
        data["usable_soc"].iloc[-1] * 100,
        color=color,
        marker=marker,
        s=65,
        zorder=5
    )

ax.set_title(
    "ER3 | Battery Energy Remaining During Required Maneuvers\n"
    "Each simulation starts with a fresh modeled battery"
)

ax.set_xlabel("Time (s)")
ax.set_ylabel("Usable battery energy remaining (%)")

ax.set_ylim(83, 101)
ax.set_xlim(left=0)

ax.grid(True, alpha=0.25)
ax.legend(loc="lower left")

plt.tight_layout()
plt.show()
